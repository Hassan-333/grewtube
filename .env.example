# Copy this file to .env and fill in the values:  cp .env.example .env
# Never commit .env. It is already in .gitignore.

# ---------- Required ----------

# MongoDB. This default works with `docker compose up -d`.
MONGO_URL=mongodb://127.0.0.1:27017/grewtube

# The URL you open the app at, and a random secret used to sign login sessions.
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# YouTube Data API v3 key. Needed to analyse videos.
# Google Cloud Console > APIs & Services > enable "YouTube Data API v3" > Credentials > Create API key
YOUTUBE_API_KEY=

# ---------- Optional ----------

# Admin account for /admin. It is not stored in MongoDB; log in with these on /login.
# Leave empty to disable the admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Google sign-in. Leave empty and the app works with email/password only.
# OAuth client type "Web application", authorised redirect URI:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Stripe test-mode keys for the Upgrade page. Leave empty to disable checkout.
# The price IDs in app/api/checkout/route.ts belong to the original Stripe
# account; with your own account, create a product and swap those IDs in.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
